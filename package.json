{
  "name": "medical-api-core",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=development && nest start --watch",
    "repl": "cross-env NODE_ENV=development node dist/src/main.js --repl",
    "start:debug": "nest start --debug --watch",
    "start:prod": "nest build && cross-env NODE_ENV=production node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "vitest": "vitest",
    "vitest:run": "vitest --run", 
    "vitest:coverage": "vitest run --coverage",
    "vitest:ui": "vitest --ui --coverage.enabled=true",
    "prisma:generate": "prisma generate --schema=./src/providers/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema=./src/providers/prisma/schema.prisma",
    "prisma": "prisma --schema=./src/providers/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=./src/providers/prisma/schema.prisma",
    "prisma:dev": "prisma migrate dev --schema=./src/providers/prisma/schema.prisma",
    "create:db": "chmod +x ./bin/setup_local_db.sh && ./bin/setup_local_db.sh",
    "commit": "git diff --staged HEAD > .commit_diff && npx openai api chat.completions.create -m gpt-4 -p \"Genera un mensaje de commit en formato convencional para estos cambios:\n$(cat .commit_diff)\" | pbcopy"
  },
  "dependencies": {
    "@anatine/zod-nestjs": "^2.0.9",
    "@anatine/zod-openapi": "^2.2.6",
    "@nestjs/common": "^10.3.9",
