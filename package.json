    "@nestjs/core": "^10.3.9",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.3.9",
    "@nestjs/swagger": "^7.3.1",
    "@prisma/client": "^6.2.1",
    "@sendgrid/mail": "^8.1.4",
    "@sentry/nestjs": "^8.54.0",
    "@sentry/profiling-node": "^8.54.0",
    "@sentry/vite-plugin": "^3.1.1",
    "@supabase/supabase-js": "^2.48.1",
    "axios": "^1.7.7",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.7.0",
    "nestjs-pino": "^4.3.0",
    "openai": "^4.47.3",
    "openapi3-ts": "^4.4.0",
    "passport-http-bearer": "^1.0.1",
