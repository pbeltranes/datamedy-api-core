{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "src",
    "types": ["vite/client"],
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": false,
    "strict": true,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@/*": ["./*"],
      "@users/*": ["./users/*"]
    },
  },
  "include": ["./public","src/**/*.ts", "prisma", "vite.config.ts", "vitest.config.ts"]
}
