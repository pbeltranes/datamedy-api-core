generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Cambiar al proveedor que uses, como MySQL o SQLite
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")

}

model User {
  id             Int         @id @default(autoincrement())
  username       String      @unique
  email          String      @unique
  name           String
  phone          String
  createdAt      DateTime    @default(now())
  membership     Membership? @relation(fields: [membershipId], references: [id])
  membershipId   Int?
  profile        Profile?
}

model Membership {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  price       Decimal   // Mejor usar Decimal para precios
  description String
  isActive    Boolean   @default(true)
  users       User[]
}

model Profile {
  id                 Int      @id @default(autoincrement())
  rut                String   @unique
  fullName           String
  birthDate          DateTime
  nationality        String
  registrationNumber String
  profilePhotoUrl    String?  // Ruta o URL
  idCardFrontUrl     String   // Ruta o URL
  idCardBackUrl      String   // Ruta o URL
  phone              String
  specialty          String
  subspecialty       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  userId             Int      @unique
  User               User     @relation(fields: [userId], references: [id])
}